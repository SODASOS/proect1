# Админ - управление вопросами
@app.route('/admin', methods=['GET', 'POST'])
@login_required
def admin():
    if current_user.role != 'teacher':
        flash('Access denied')
        return redirect(url_for('dashboard'))
    if request.method == 'POST':
        question_text = request.form.get('question')
        options_texts = [
            request.form.get('option1'),
            request.form.get('option2'),
            request.form.get('option3'),
            request.form.get('option4')
        ]
        correct_option = request.form.get('correct_option')  # '1', '2', '3', '4'
        q = Question(question_text=question_text)
        for idx, opt_text in enumerate(options_texts):
            is_correct = (str(idx+1) == correct_option)
            o = Option(option_text=opt_text, is_correct=is_correct)
            q.options.append(o)
        db.session.add(q)
        db.session.commit()
        flash('Question added')
    return render_template('admin.html')

# Получение вопросов (AJAX)
@app.route('/api/questions')
@login_required
def get_questions():
    questions = Question.query.all()
    data = []
    for q in questions:
        options = [{'id': o.id, 'text': o.option_text, 'correct': o.is_correct} for o in q.options]
        data.append({'id': q.id, 'question': q.question_text, 'options': options})
    return jsonify(data)

# Отправка ответов
@app.route('/api/submit', methods=['POST'])
@login_required
def submit():
    answers = request.json.get('answers')  # {'question_id': option_id}
    questions = Question.query.all()
    score = 0
    total = len(questions)
    for q in questions:
        selected_option_id = answers.get(str(q.id))
        if selected_option_id:
            option = Option.query.get(selected_option_id)
            if option and option.is_correct:
                score += 1
    # сохранить результат
    result = Result(user_id=current_user.id, score=score, total_questions=total)
    db.session.add(result)
    db.session.commit()
    return jsonify({'score': score, 'total': total})

